# Doxyfile for CurseStone
#
# Verified against Doxygen 1.9.1 (the version installed in this workspace).
# Options not listed here use Doxygen defaults. Output goes to build/docs/,
# which is already covered by .gitignore (build/), so generated HTML never
# lands in the source tree.
#
# Usage:
#   mkdir -p build/docs
#   doxygen Doxyfile
#   open build/docs/html/index.html
#
# (mkdir is required: Doxygen 1.9.1 creates the output directory but not
# missing parent directories.)

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
PROJECT_NAME           = "CurseStone"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Open source Minecraft: Pocket Edition 0.15.x server (protocol 84)"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
# Project-owned C/C++ sources plus the top-level Markdown documents.
# third_party/ (bundled Lua 5.4) and generated/build directories are excluded.
INPUT                   = README.md \
                          CONTRIBUTING.md \
                          BUILDING.md \
                          docs \
                          src
FILE_PATTERNS           = *.c \
                          *.cc \
                          *.cpp \
                          *.cxx \
                          *.h \
                          *.hpp \
                          *.hh \
                          *.md
RECURSIVE               = YES
EXCLUDE                 = third_party
EXCLUDE_PATTERNS        = build/* \
                          */__pycache__/* \
                          src/legacy/*
EXCLUDE_SYMBOLS         =
INPUT_ENCODING          = UTF-8

# Markdown behaves as regular Markdown; README.md is the landing page.
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = README.md

# ---------------------------------------------------------------------------
# Extraction / warning behaviour (staged migration friendly)
# ---------------------------------------------------------------------------
# Only explicitly documented entities are extracted as documented API, but
# Doxygen still reports undocumented public/protected members as warnings so
# batches can be migrated incrementally. Warnings are NOT fatal while the
# migration is incomplete; flip WARN_AS_ERROR to FAIL_ON_WARNINGS once the
# backlog is cleared.
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
EXTRACT_LOCAL_CLASSES   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARNINGS                = YES
QUIET                   = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_NO_PARAMDOC        = NO
WARN_AS_ERROR           = NO
WARN_LOGFILE            = build/docs/doxygen-warnings.log

# ---------------------------------------------------------------------------
# Preprocessing
# ---------------------------------------------------------------------------
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = NO
SKIP_FUNCTION_MACROS    = YES
PREDEFINED              =
EXPAND_AS_DEFINED       =

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
GENERATE_HTML           = YES
HTML_OUTPUT             = html
HTML_DYNAMIC_SECTIONS   = YES
GENERATE_TREEVIEW       = YES
GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_MAN            = NO
SEARCHENGINE            = YES
SOURCE_BROWSER          = NO
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = NO
REFERENCES_RELATION     = NO
ALIASES                 =
CLASS_DIAGRAMS          = NO
HAVE_DOT                = NO

# ---------------------------------------------------------------------------
# Comment style
# ---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = YES
MULTILINE_CPP_IS_BRIEF  = NO
BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
ALWAYS_DETAILED_SEC     = NO
INLINE_INHERITED_MEMB   = NO
# Doxygen shorthand (@brief, @param, ...) and backslash forms are both accepted.
# See docs/STYLE_COMMENTS.md for the project convention.
