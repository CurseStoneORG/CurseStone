{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "build/android-arm64",
      "toolchainFile": "cmake/Android.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "20"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug"   },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ]
}
